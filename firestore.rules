rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios: cualquier auth puede leer perfiles (para búsqueda de amigos)
    // Solo el propio usuario puede escribir su doc
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Proyectos: top-level collection, accesible por todos los miembros
    match /projects/{projectId} {
      function isMember() {
        return request.auth != null
          && request.auth.uid in resource.data.memberIds;
      }
      function isOwner() {
        return request.auth != null
          && request.auth.uid == resource.data.ownerId;
      }
      function isMemberOnCreate() {
        return request.auth != null
          && request.auth.uid in request.resource.data.memberIds;
      }
      function hasPendingInvitation() {
        // Invitation ID format: "{projectId}_{request.auth.uid}"
        return request.auth != null
          && get(/databases/$(database)/documents/projectInvitations/$(projectId + '_' + request.auth.uid)).data.status == 'pending';
      }

      allow read: if isMember();
      allow create: if isMemberOnCreate()
                    && request.auth.uid == request.resource.data.ownerId;
      allow update: if isMember() || hasPendingInvitation();
      allow delete: if isOwner();

      // Piezas del proyecto: cualquier miembro puede leer y escribir
      match /pieces/{pieceId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds;
      }
    }

    // Invitaciones a proyectos: solo emisor y receptor pueden leer
    // resource == null guard: allows reading non-existent docs (hasPendingProjectInvitation checks)
    match /projectInvitations/{inviteId} {
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid == resource.data.fromUserId
                      || request.auth.uid == resource.data.toUserId);
      // Sender must be authenticated as fromUserId AND be a member of the target project
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.fromUserId
                    && request.auth.uid in get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.memberIds;
      // Receiver (toUserId) can update status (accept/reject); owner can cancel (set rejected)
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.toUserId
                        || request.auth.uid == resource.data.fromUserId);
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.fromUserId
                        || request.auth.uid == resource.data.toUserId);
    }

    // Solicitudes de amistad
    match /friendRequests/{requestId} {
      // resource is null for non-existent docs (e.g. hasPendingRequest checking a path that doesn't exist yet)
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid == resource.data.fromUserId
                      || request.auth.uid == resource.data.toUserId);
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.fromUserId;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.toUserId;
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.fromUserId
                        || request.auth.uid == resource.data.toUserId);
    }

    // Lista de amigos por usuario
    match /users/{userId}/friends/{friendId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Own writes/deletes
      allow write: if request.auth != null && request.auth.uid == userId;
      // Bilateral accept: accepter (auth.uid == friendId) writes to the sender's (userId) friends list.
      // Requires a pending friendRequest with ID "{userId}_{friendId}" (sent from userId to friendId).
      allow create, update: if request.auth != null
        && request.auth.uid == friendId
        && get(/databases/$(database)/documents/friendRequests/$(userId + '_' + friendId)).data.status == 'pending';
      // Bilateral remove: the removed friend (auth.uid == friendId) can delete their own entry
      // in the other user's friends list. Constrained: can only delete their own UID's entry.
      allow delete: if request.auth != null && request.auth.uid == friendId;
    }

    // Caché de inventarios de sets: cualquier usuario auth puede leer y crear (primera vez)
    // El caché es inmutable — no se puede actualizar ni eliminar
    match /sets/{setId}/pieces/{pieceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // MOCs de comunidad: cualquiera puede leer (es contenido público), solo auth puede crear
    match /community_projects/{mocId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80;
      // El autor puede actualizar solo imageUrl (el upload se hace después del create)
      // Cualquier auth puede incrementar cloneCount
      // Solo el autor puede borrar su MOC
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.authorId
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cloneCount', 'likeCount', 'status']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;

      // Piezas del MOC: cualquiera puede leer, solo el autor puede escribir
      match /pieces/{pieceId} {
        allow read: if true;
        allow write: if request.auth != null
                     && request.auth.uid == get(/databases/$(database)/documents/community_projects/$(mocId)).data.authorId;
      }

      // Likes: cualquier usuario auth puede crear/borrar su propio like
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Reportes: solo el usuario auth puede crear el suyo, nadie puede leer/editar
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
